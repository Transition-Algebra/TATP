load ccs.ta

spec MAP-REDUCE is
  including CCS .

  sorts Id, IdSet .
  op none : () -> IdSet .
  op Id : Id -> IdSet .
  op __ : IdSet IdSet -> IdSet [assoc comm id: (none)] .

  sort Data .

  sorts Key, KeySet .
  op none : () -> KeySet .
  op Key : Key -> KeySet .
  op __ : KeySet KeySet -> KeySet [assoc comm id: (none)] .

  sort Value .
  op 0 : () -> Value .
  op _+_ : Value Value -> Value [assoc comm id: (0)] .

  sorts KVSet .
  op none : () -> KVSet .
  op <_:_> : Key Value -> KVSet .
  op __ : KVSet KVSet -> KVSet [assoc comm id: (none)] .

  op f : Key Data -> Value .

  ops JobManager, TaskDistributor, TaskMonitor : KeySet IdSet -> Process .
  op Node : Id Data -> Process .
  op Mapper : Id KeySet Data -> Process .
  op Reducers : KeySet -> Process .
  op Reducer : Key Value -> Process .
  op Collector : KeySet KVSet -> Process .

  op map : KeySet Id -> Channel .
  ops local-output, global-output : Key Value -> Channel .
  op eom : Id -> Channel .
  op eor : Key -> Channel .

  var  K : Key .
  var  KS : KeySet .
  var  X : Id .
  var  IdS : IdSet .
  vars V, R : Value .
  var  KVS : KVSet .
  var  D : Data .

  ax JobManager(KS, IdS)
     =(def)> TaskDistributor(KS, IdS)
           | TaskMonitor(KS, IdS)
           | Reducers(KS)
           | Collector(KS, none)
     [label: def-JobManager] .

  ax TaskDistributor(KS, Id(X) IdS)
     =(def)> (snd(map(KS, X)) . TaskDistributor(KS, IdS))
     [label: def-TaskDistributor] .
  ax TaskDistributor(KS, none)
     =(def)> 0
     [label: def-TaskDistributor] .

  ax TaskMonitor(KS, Id(X) IdS)
     =(def)> (rcv(eom(X)) . TaskMonitor(KS, IdS))
     [label: def-TaskMonitor] .
  ax TaskMonitor(Key(K) KS, none)
     =(def)> (snd(eor(K)) . TaskMonitor(KS, none))
     [label: def-TaskMonitor] .
  ax TaskMonitor(none, none)
     =(def)> 0
     [label: def-TaskMonitor] .

  ax Reducers(Key(K) KS)
     =(def)> Reducer(K, 0)
           | Reducers(KS)
     [label: def-Reducers] .
  ax Reducers(none)
     =(def)> 0
     [label: def-Reducers] .

  ax Collector(Key(K) KS, KVS)
     =(def)> (rcv(global-output(K, V)) . Collector(KS, < K : V > KVS))
     [label: def-Collector] .

  ax Node(X, D)
     =(def)> (rcv(map(KS, X)) . Mapper(X, KS, D))
     [label: def-Node] .
  ax Mapper(X, Key(K) KS, D)
     =(def)> (snd(local-output(K, f(K, D))) . Mapper(X, KS, D))
     [label: def-Mapper] .
  ax Mapper(X, none, D)
     =(def)> (snd(eom(X)) . Node(X, D))
     [label: def-Mapper] .

  ax Reducer(K, R)
     =(def)> ((rcv(local-output(K, V)) . Reducer(K, R + V))
            + (rcv(eor(K)) . snd(global-output(K, R)) . 0))
     [label: def-Reducer] .
endspec

open MAP-REDUCE
  let X1, X2 : Id
  let D1, D2 : Data
  let K1, K2 : Key
  echeck
    JobManager(Key(K1) Key(K2), Id(X1) Id(X2))
    | Node(X1, D1)
    | Node(X2, D2)
  =((tau)*)>
    Collector(none, < K1 : f(K1, D1) + f(K1, D2) > < K2 : f(K2, D1) + f(K2, D2) >)
    | R:Process
  using (star comp
         `` 1st transition
         `` initialize the 1st mapper through the synchronization of TaskDistributor and one of the nodes
         scom
         con def-JobManager
         ucom con def-TaskDistributor act
         ucom con def-Node act
         star comp
         `` 2nd transition
         `` initialize the 2nd mapper through the synchronization of TaskDistributor and the remaining node
         ucom scom
         con def-TaskDistributor act
         con def-Node act
         star comp
         `` 3rd transition
         `` initialize the 1st reducer and deliver the first local output to it
         ucom
         scom
         con def-Mapper act
         con def-Reducers
         ucom con def-Reducer sum act
         star comp
         `` 4th transition
         `` initialize the 2nd reducer and deliver the next local output
         ucom
         scom
         con def-Mapper act
         con def-Reducers
         con def-Reducer sum act
         star comp
         `` 5th transition
         `` deliver the 3rd local output to one of the reducers
         ucom
         scom
         con def-Mapper act
         con def-Reducer sum act
         star comp
         `` 6th transition
         `` deliver the 4th local output to one of the reducers
         ucom
         scom
         con def-Mapper act
         con def-Reducer sum act
         star comp
         `` 7th transition
         `` notify the TaskMonitor that one of the mappers has completed its execution
         ucom
         scom
         con def-Mapper act
         con def-TaskMonitor act
         star comp
         `` 8th transition
         `` ditto for the remaining mapper
         ucom scom
         con def-Mapper act
         con def-TaskMonitor act
         star comp
         `` 9th transition
         `` inform one of the reducers that there are no more local outputs to aggregate
         ucom
         scom
         con def-TaskMonitor act
         con def-Reducer sum act
         star comp
         `` 10th transition
         `` ditto for the second reducer
         ucom
         scom
         con def-TaskMonitor act
         con def-Reducer sum act
         star comp
         `` 11th transition
         `` collect the 1st global output
         ucom
         scom
         act
         con def-Collector act
         star comp
         `` 12th transition
         `` collect the 2nd global output
         ucom
         scom
         act
         con def-Collector act
         star)
  `` satisfied in 1.3 hours
close
